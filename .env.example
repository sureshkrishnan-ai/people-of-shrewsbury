# People of City · environment
# Copy to .env.local (never commit it: .env* is git-ignored) and fill in your own values.
# With these left as they are, the city still runs as a guest walk-through with sample residents.

# Supabase (https://supabase.com → your project → Settings → API)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Safe in the browser: row-level security guards the data
SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
# Server only (src/lib/server). Never expose it to the browser or commit it
SUPABASE_SECRET_KEY=sb_secret_YOUR_KEY

# Protects /api/cron/chat-digest (unread-message reminders). Any long random string
CRON_SECRET=any-long-random-string

# Live city room server (realtime/). Leave empty for no live positions: the game works without it.
# Local: `npm run rt:dev` serves it at http://localhost:8787
NEXT_PUBLIC_REALTIME_URL=

# Your public address (e.g. https://peopleofshrewsbury.org). Empty: the placeholder in src/city/config.ts
NEXT_PUBLIC_SITE_URL=
